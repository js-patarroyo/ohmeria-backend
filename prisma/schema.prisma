// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  SPECIALIST
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceCategory {
  WELLNESS_BEAUTY
  MEDICAL
}

enum AppointmentStatus {
  REQUEST_RECEIVED
  PENDING_CONFIRMATION
  REQUIRES_PRE_ASSESSMENT
  CONFIRMED
  IN_PREPARATION
  IN_PROGRESS
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
  FOLLOW_UP_PENDING
  FOLLOW_UP_COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum SaleStatus {
  PAID
  PENDING
  RESERVED
  CANCELLED
}

enum SalePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MIXED
  PENDING
}

enum SaleItemType {
  PRODUCT
  SERVICE
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             Role
  status           UserStatus      @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  staffProfile     StaffProfile?
  clientProfile    ClientProfile?
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")
  appointmentConflictOverrides AppointmentConflictOverride[] @relation("AppointmentConflictOverrideActor")
  passwordResetTokens PasswordResetToken[]
  salesCreated     Sale[]          @relation("SaleCreatedBy")
}

model StaffProfile {
  id              String     @id @default(cuid())
  userId          String     @unique
  title           String?
  bio             String?
  isAvailable     Boolean    @default(true)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]  @relation("StaffServices")
  appointments    Appointment[] @relation("AppointmentAssignedTo")
}

model ClientProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  lifecycleStatus   String        @default("activo")
  document          String?
  city              String?
  address           String?
  emergencyContact  String?
  birthDate         DateTime?
  preferences       String?
  notes             String?
  allergies         String?
  contraindications String?
  conditions        String?
  consultReason     String?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  sales             Sale[]
}

model Service {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  description          String?
  fullDescription      String?
  category             ServiceCategory
  status               String           @default("activo")
  durationMinutes      Int
  price                Decimal          @db.Decimal(10, 2)
  promoPrice           Decimal?         @db.Decimal(10, 2)
  depositRequired      Decimal?         @db.Decimal(10, 2)
  professionalLabel    String?
  professionalRole     String?
  requiresAssessment   Boolean          @default(false)
  requiresFollowUp     Boolean          @default(false)
  featured             Boolean          @default(false)
  preparationNotes     String?
  aftercareNotes       String?
  suggestedFrequency   String?
  internalNotes        String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  assignedStaff        StaffProfile[]   @relation("StaffServices")
  appointments         Appointment[]
  saleItems            SaleItem[]
}

model Appointment {
  id                String               @id @default(cuid())
  clientProfileId   String
  serviceId         String
  assignedStaffId   String?
  createdById       String?
  scheduledAt       DateTime
  durationMinutes   Int
  cabin             String?
  status            AppointmentStatus    @default(REQUEST_RECEIVED)
  paymentStatus     PaymentStatus        @default(PENDING)
  notes             String?
  internalNotes     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  clientProfile     ClientProfile        @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  service           Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedStaff     StaffProfile?        @relation("AppointmentAssignedTo", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy         User?                @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  statusHistory     AppointmentStatusLog[]
  conflictOverrides AppointmentConflictOverride[]
}

model AppointmentStatusLog {
  id             String             @id @default(cuid())
  appointmentId  String
  fromStatus     AppointmentStatus?
  toStatus       AppointmentStatus
  note           String?
  createdAt      DateTime           @default(now())
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AppointmentConflictOverride {
  id                     String       @id @default(cuid())
  appointmentId          String
  actorUserId            String
  source                 String
  reason                 String
  conflictTypes          String[]
  conflictingAppointmentIds String[]
  createdAt              DateTime     @default(now())
  appointment            Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorUser              User         @relation("AppointmentConflictOverrideActor", fields: [actorUserId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  fullDescription String?
  category        String
  brand           String?
  presentation    String?
  sku             String?
  status          String    @default("disponible")
  price           Decimal   @db.Decimal(10, 2)
  internalCost    Decimal?  @db.Decimal(10, 2)
  taxRate         Int       @default(0)
  stock           Int       @default(0)
  stockMin        Int?
  unit            String?
  featured        Boolean   @default(false)
  lowStockAlert   Boolean   @default(true)
  relatedServices String[]
  notes           String?
  imageUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  saleItems       SaleItem[]
}

model Sale {
  id             String             @id @default(cuid())
  clientProfileId String?
  createdById    String?
  status         SaleStatus         @default(PENDING)
  paymentMethod  SalePaymentMethod  @default(PENDING)
  isWalkIn       Boolean            @default(false)
  subtotal       Decimal            @db.Decimal(10, 2)
  total          Decimal            @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  clientProfile  ClientProfile?     @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          SaleItem[]
}

model SaleItem {
  id          String       @id @default(cuid())
  saleId      String
  type        SaleItemType
  productId   String?
  serviceId   String?
  name        String
  category    String?
  quantity    Int          @default(1)
  unitPrice   Decimal      @db.Decimal(10, 2)
  totalPrice  Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}
